{
  "name": "msma-hris-mobile-ui",
  "version": "0.1.0",
  "private": true,
  "description": "MSMA HRIS employee app, Mobile UI (Expo), copied from MSMA-HRIS-backend/apps/mobile and restyled to the website design",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "build:dev:android": "npx --yes eas-cli@^24 build --platform android --profile development",
    "build:dev:ios": "npx --yes eas-cli@^24 build --platform ios --profile development",
    "build:dev:ios-simulator": "npx --yes eas-cli@^24 build --platform ios --profile development-simulator",
    "mobile": "node scripts/mobile.mjs",
    "mobile:tunnel": "node scripts/mobile.mjs --tunnel",
    "mobile:clear": "node scripts/mobile.mjs --clear",
    "preview": "expo start --web --port 8090",
    "check:streak": "npx --yes tsx --tsconfig tsconfig.json scripts/streak-check.ts",
    "mobile:fast": "node scripts/mobile.mjs --no-dev --minify",
    "check:time": "npx --yes tsx --tsconfig tsconfig.json scripts/time-check.ts"
  },
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "^5.104.0",
    "decimal.js": "^10.6.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
