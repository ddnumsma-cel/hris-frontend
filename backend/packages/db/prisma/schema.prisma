// MSMA HRIS database schema. Synthetic data only.
// Money: Decimal @db.Decimal(14, 2). Instants: UTC timestamptz. Calendar dates: @db.Date holding the Manila date.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum EmploymentStatus {
  PROBATIONARY
  REGULAR
  CONTRACTUAL
  PROJECT
}

enum Role {
  EMPLOYEE
  MANAGER
  HR_ADMIN
  PAYROLL_ADMIN
  SYSTEM_ADMIN
  /// The IT team's shared account (the website's System Admin): support, plans and seats; no HR, pay or attendance data
  PLATFORM_ADMIN
}

enum VerifyMode {
  FACE
  FINGER
  PIN
  SELFIE
  /// Phone clock-in confirmed with the phone's fingerprint or face unlock (the biometric never leaves the phone)
  PHONE_BIOMETRIC
  /// Phone clock-in confirmed with the phone's PIN, pattern or password
  PHONE_PASSCODE
}

enum HolidayType {
  REGULAR
  SPECIAL
}

enum DtrStatus {
  PRESENT
  ABSENT
  LEAVE
  RESTDAY
  HOLIDAY
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalType {
  LEAVE
  OT
  /// Permission to leave before the shift ends (the minutes are still unpaid; approval excuses them)
  UNDERTIME
  DTR_FIX
}

enum PayrollRunStatus {
  DRAFT
  COMPUTED
  REVIEWED
  APPROVED
  LOCKED
  RELEASED
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
  ANNULLED
}

enum Sex {
  MALE
  FEMALE
}

enum DependentRelationship {
  CHILD
  SPOUSE
  PARENT
  SIBLING
  OTHER
}

/// 201 file document types (catalog and rules: packages/shared/src/records201.ts)
enum DocumentType {
  RESUME
  BIRTH_CERTIFICATE
  MARRIAGE_CERTIFICATE
  CHILD_BIRTH_CERTIFICATE
  GOVERNMENT_ID
  DIPLOMA_TOR
  PROFESSIONAL_LICENSE
  PREVIOUS_COE
  NBI_CLEARANCE
  POLICE_CLEARANCE
  MEDICAL_RESULTS
  TIN_BIR_1902
  SSS_E1
  PHILHEALTH_PMRF
  PAGIBIG_MDF
  PREVIOUS_BIR_2316
  EMPLOYMENT_CONTRACT
  JOB_DESCRIPTION
  PERSONAL_DATA_SHEET
  PROBATION_REGULARIZATION
  PERSONNEL_ACTION
  HANDBOOK_ACKNOWLEDGMENT
  DATA_PRIVACY_CONSENT
  BIOMETRIC_CONSENT
  NDA
  PERFORMANCE_APPRAISAL
  TRAINING_CERTIFICATE
  LEAVE_RECORDS
  COMMENDATION
  DISCIPLINARY_RECORD
  LOAN_DOCUMENT
  RECORD_UPDATE
  RESIGNATION_LETTER
  TERMINATION_NOTICE
  CLEARANCE_FORM
  FINAL_PAY_QUITCLAIM
  COE_ISSUED
  SEPARATION_BIR_2316
}

enum EmploymentEventType {
  HIRED
  REGULARIZED
  PROMOTED
  TRANSFERRED
  SALARY_ADJUSTED
  SEPARATED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum TextSize {
  STANDARD
  LARGE
}

enum TableDensity {
  COMFORTABLE
  COMPACT
}

// ---------- Organisation ----------

model Site {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  address      String?
  /// Who to call at this office
  contactName  String?
  contactPhone String?
  /// The office manager
  managerId    String?
  manager      Employee?        @relation("SiteManager", fields: [managerId], references: [id])
  /// Inactive offices stay on old records but can't take new people
  active       Boolean          @default(true)
  employees    Employee[]
  devices      Device[]
  departments  SiteDepartment[]
}

model Department {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  positions Position[]
  employees Employee[]
  sites     SiteDepartment[]
}

/// A department as it exists at one office (the website lists departments per office), with its own head.
model SiteDepartment {
  siteId         String
  site           Site       @relation(fields: [siteId], references: [id])
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  headEmployeeId String?
  head           Employee?  @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  @@id([siteId, departmentId])
}

model Position {
  id           String     @id @default(cuid())
  title        String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]

  @@unique([departmentId, title])
}

model Shift {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  /// Manila wall-clock "HH:mm"
  startTime    String
  /// Manila wall-clock "HH:mm"; earlier than startTime means an overnight shift
  endTime      String
  breakMinutes Int        @default(60)
  graceMinutes Int        @default(5)
  /// 0 = Sunday … 6 = Saturday
  workDays     Int[]
  /// When the unpaid lunch starts ("12:00"); only the part of it they were at work is taken out. Null = the old rule
  /// (the whole break off when they stayed over 5 hours).
  breakStart      String?
  /// Flexible time: clock in any time from startTime, done by endTime; no lateness, only requiredMinutes counts
  flexible        Boolean    @default(false)
  /// Flexible shifts: minutes to work, not counting lunch (480 = 8 hours)
  requiredMinutes Int?
  /// A shorter Saturday ("12:00"), when the shift has one
  saturdayEnd     String?
  /// Inactive shifts can't be picked any more; people on them keep them until moved
  active          Boolean    @default(true)
  employees    Employee[]
}

model Holiday {
  id   String      @id @default(cuid())
  date DateTime    @unique @db.Date
  name String
  type HolidayType
}

// ---------- People ----------

model Employee {
  id           String           @id @default(cuid())
  employeeNo   String           @unique
  /// PIN enrolled on the biometric terminals (ZKTeco "PIN" field)
  biometricPin String           @unique
  firstName    String
  middleName   String?
  lastName     String
  email        String?
  mobileNo     String?
  birthDate    DateTime?        @db.Date
  status       EmploymentStatus
  hireDate     DateTime         @db.Date
  active       Boolean          @default(true)
  dailyRate    Decimal          @db.Decimal(14, 2)
  /// Monthly salary (payroll pays half each cut-off; daily = monthly × 12 ÷ 261, as MSMA's payroll workbook)
  monthlySalary Decimal?        @db.Decimal(14, 2)
  siteId       String
  site         Site             @relation(fields: [siteId], references: [id])
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  positionId   String?
  position     Position?        @relation(fields: [positionId], references: [id])
  shiftId      String
  shift        Shift            @relation(fields: [shiftId], references: [id])
  managerId    String?
  manager      Employee?        @relation("ManagerReports", fields: [managerId], references: [id])
  reports      Employee[]       @relation("ManagerReports")
  managedSites Site[]           @relation("SiteManager")
  headOf       SiteDepartment[] @relation("DepartmentHead")

  // Personal data sheet (201 file)
  /// e.g. "Jr.", "III"
  suffix                String?
  sex                   Sex?
  nationality           String?
  civilStatus           CivilStatus?
  /// Street / barangay; city and province are kept apart
  address               String?
  city                  String?
  province              String?
  /// MSMA department code (RPM, VCM or ADS), picked when hiring
  cluster               String?
  /// Where take-home pay is sent: all three or none
  bankName              String?
  bankAccountName       String?
  bankAccountNo         String?
  personalEmail         String?
  emergencyName         String?
  emergencyRelationship String?
  emergencyPhone        String?
  /// e.g. "PRC (CPA)"; set when the role needs a professional license
  licenseType           String?
  /// CPD units the employee has logged for the license's current cycle
  cpdUnitsEarned        Int?
  regularizationDate    DateTime?    @db.Date
  separationDate        DateTime?    @db.Date
  separationReason      String?
  /// Set only after the biometric consent form is on file (consent first)
  biometricEnrolledAt   DateTime?    @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  govId             GovId?
  user              User?
  punches           RawPunch[]
  dtrs              DailyTimeRecord[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  otRequests        OtRequest[]
  dtrCorrections    DtrCorrection[]
  undertimeRequests UndertimeRequest[]
  approvals         ApprovalRequest[]
  payslips          Payslip[]
  payProfile        PayProfile?
  loans             Loan[]
  leaveAdjustments  LeaveAdjustment[]
  policyAcks        PolicyAck[]
  trainings         TrainingRecord[]
  claims            Claim[]
  certificates      CertificateRequest[]
  dependents        Dependent[]
  documents         EmployeeDocument[]
  documentRequirements DocumentRequirement[]
  wfhDays              WfhDay[]
  cases                EmployeeCase[]
  attendanceNotices    AttendanceNotice[]
  photo                EmployeePhoto?
  performanceReviews   PerformanceReview[]
  remotePunches        RemotePunch[]
  events            EmploymentEvent[]

  @@index([siteId])
  @@index([departmentId])
  @@index([managerId])
  @@index([lastName, firstName])
}

/// Government IDs (synthetic, correctly formatted)
model GovId {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// 000-000-000-000
  tin        String
  /// 00-0000000-0
  sss        String
  /// 00-000000000-0
  philhealth String
  /// 0000-0000-0000
  pagibig    String
}

model Dependent {
  id           String                @id @default(cuid())
  employeeId   String
  employee     Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  relationship DependentRelationship
  birthDate    DateTime?             @db.Date

  @@index([employeeId])
}

/// A file in the 201 file. The file itself lives in the document store (local disk now, S3 on AWS), not in the DB.
/// The app never hard-deletes documents: HR archives them with a reason; retention rules decide disposal.
model EmployeeDocument {
  id             String       @id @default(cuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  type           DocumentType
  /// Original file name, for display and download only
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  /// Key in the document store, generated by the server (never from user input)
  storageKey     String
  issuedOn       DateTime?    @db.Date
  expiresOn      DateTime?    @db.Date
  /// ID or license number, consent form version, training title (see referenceLabel in the catalog)
  referenceNo    String?
  notes          String?
  uploadedById   String?
  uploadedBy     User?        @relation("DocumentUploads", fields: [uploadedById], references: [id])
  uploadedAt     DateTime     @default(now()) @db.Timestamptz(3)
  /// SUBMITTED: the employee uploaded it and HR hasn't checked it yet; VERIFIED: checked against the original
  /// (HR's own uploads are verified)
  reviewStatus   String       @default("VERIFIED")
  reviewedById   String?
  reviewedAt     DateTime?    @db.Timestamptz(3)
  archivedAt     DateTime?    @db.Timestamptz(3)
  archivedReason String?

  @@index([employeeId, type])
  @@index([expiresOn])
}

/// HR's decision on one paper for one person: not applicable to them, or required although the usual rule says not,
/// and the note when HR returned an upload for resubmission (shown to the employee until they upload again).
model DocumentRequirement {
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        DocumentType
  /// NOT_APPLICABLE, REQUIRED, or null (the usual rule applies)
  state       String?
  returnNote  String?
  updatedById String?
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@id([employeeId, type])
}

/// Remote work days the Super Admin declared (typhoons, emergencies): everyone, or the listed offices (site names).
model RemoteDay {
  id           String    @id @default(cuid())
  fromDate     DateTime  @db.Date
  toDate       DateTime  @db.Date
  offices      String[]
  reason       String
  declaredBy   String
  declaredById String?
  declaredAt   DateTime  @default(now()) @db.Timestamptz(3)
  cancelledAt  DateTime? @db.Timestamptz(3)

  @@index([fromDate, toDate])
}

/// A punch set aside: kept on record but not counted (e.g. a home punch after switching back to an office day).
/// Punches are append-only, so this is a separate record pointing at one.
model PunchVoid {
  rawPunchId String   @id
  rawPunch   RawPunch @relation(fields: [rawPunchId], references: [id])
  reason     String
  by         String
  at         DateTime @default(now()) @db.Timestamptz(3)
}

/// A day someone chose to work from home themselves (one per person per day).
model WfhDay {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  declaredAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([employeeId, date])
}

/// A time-in or time-out made from home with the website's face scan; the punch itself is a RawPunch.
model RemotePunch {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate     DateTime  @db.Date
  /// in or out
  kind         String
  punchedAt    DateTime  @db.Timestamptz(3)
  /// Face match, 0–100
  match        Int?
  lat          Float?
  lng          Float?
  accuracy     Float?
  /// Why there's no location (permission denied, no GPS)
  locationNote String?
  reason       String
  recordedBy   String
  rawPunchId   String?
  voidedAt     DateTime? @db.Timestamptz(3)
  voidReason   String?
  voidedBy     String?

  @@index([employeeId, workDate])
}

/// An employee relations case an approver (or the Super Admin) filed about someone on their team. Sensitive: never
/// shown to the employee concerned; taken off the list (closedAt), never deleted.
model EmployeeCase {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  /// Attendance, Conduct, Performance or Grievance
  type       String
  /// Open, Under review or Resolved
  status     String    @default("Open")
  summary    String
  filedBy    String
  filedById  String?
  filedAt    DateTime  @default(now()) @db.Timestamptz(3)
  closedAt   DateTime? @db.Timestamptz(3)
  closedBy   String?

  @@index([employeeId])
}

/// The employee's profile photo (a small image data URL), kept apart so employee lists don't load it.
model EmployeePhoto {
  employeeId String   @id
  employee   Employee @relation(fields: [employeeId], references: [id])
  dataUrl    String
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

/// A memo about repeated lateness or AWOL (never changes pay); the employee acknowledges it.
model AttendanceNotice {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  /// tardiness or awol
  kind           String
  subject        String
  message        String
  /// The days it is about (yyyy-mm-dd)
  dates          String[]
  sentBy         String
  sentById       String?
  sentAt         DateTime  @default(now()) @db.Timestamptz(3)
  acknowledgedAt DateTime? @db.Timestamptz(3)

  @@index([employeeId])
}

/// Whether someone's performance review for the year has been submitted.
model PerformanceReview {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  /// Submitted or Pending
  status     String
  updatedBy  String
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@id([employeeId, year])
}

/// A company announcement HR or the Super Admin posted (everyone sees it on their Home and in the bell).
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String?
  postedBy    String
  postedById  String?
  postedAt    DateTime  @default(now()) @db.Timestamptz(3)
  /// Taken down (kept for the record)
  removedAt   DateTime? @db.Timestamptz(3)

  @@index([postedAt])
}

/// Effective-dated employment history: position, site and pay changes.
model EmploymentEvent {
  id            String              @id @default(cuid())
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          EmploymentEventType
  effectiveDate DateTime            @db.Date
  positionTitle String?
  siteName      String?
  dailyRate     Decimal?            @db.Decimal(14, 2)
  remarks       String?
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  @@index([employeeId, effectiveDate])
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  passwordHash    String
  /// active, or disabled (can't sign in; signed-in sessions stop at the next request)
  status             String    @default("active")
  /// Set for a new account or a reset; cleared when they choose their own password
  mustChangePassword Boolean   @default(false)
  /// When the password was last changed or reset: sessions started before it end
  passwordChangedAt  DateTime? @db.Timestamptz(3)
  /// Who added the login (blank for the seeded ones)
  createdBy          String?
  role            Role
  displayName     String
  employeeId      String?            @unique
  employee        Employee?          @relation(fields: [employeeId], references: [id])
  /// null = app default (web: LIGHT, mobile: match device)
  theme           ThemePreference?
  textSize        TextSize           @default(STANDARD)
  tableDensity    TableDensity       @default(COMFORTABLE)
  lastLoginAt     DateTime?          @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  decidedRequests ApprovalRequest[]
  auditLogs       AuditLog[]
  uploads         EmployeeDocument[] @relation("DocumentUploads")
  notifications      Notification[]
}

// ---------- Attendance ----------

enum DeviceCommandStatus {
  /// Waiting for the terminal's next check-in
  PENDING
  /// Handed to the terminal; waiting for its reply
  SENT
  DONE
  FAILED
}

/// A command for a biometric terminal (ZKTeco ADMS "C:<id>:<command>"), sent on its next check-in.
model DeviceCommand {
  id           Int                 @id @default(autoincrement())
  deviceSerial String
  command      String
  status       DeviceCommandStatus @default(PENDING)
  /// The terminal's Return code (0 = done) or why it failed
  result       String?
  /// Who asked for it (null = the HRIS itself, e.g. after adding an employee)
  requestedBy  String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  sentAt       DateTime?           @db.Timestamptz(3)
  doneAt       DateTime?           @db.Timestamptz(3)

  @@index([deviceSerial, status])
}

/// Users enrolled on a terminal, as it last reported them.
model DeviceUser {
  deviceSerial String
  pin          String
  name         String?
  seenAt       DateTime @default(now()) @db.Timestamptz(3)

  @@id([deviceSerial, pin])
}

model Device {
  id         String    @id @default(cuid())
  serial     String    @unique
  name       String
  model      String?
  siteId     String
  site       Site      @relation(fields: [siteId], references: [id])
  lastSeenAt DateTime? @db.Timestamptz(3)
  lastIp     String?
}

/// Append-only raw clock events (a DB trigger blocks UPDATE and DELETE).
/// deviceSerial is a Device.serial, or "MOBILE-APP" for punches from the phone app.
model RawPunch {
  id           String     @id @default(cuid())
  deviceSerial String
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  punchedAt    DateTime   @db.Timestamptz(3)
  verifyMode   VerifyMode
  receivedAt   DateTime   @default(now()) @db.Timestamptz(3)
  /// Set aside (kept on record, not counted). Punches themselves can't be changed (append-only).
  setAside     PunchVoid?

  @@unique([deviceSerial, employeeId, punchedAt])
  @@index([employeeId, punchedAt])
  @@index([punchedAt])
}

model DailyTimeRecord {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id])
  date             DateTime  @db.Date
  timeIn           DateTime? @db.Timestamptz(3)
  timeOut          DateTime? @db.Timestamptz(3)
  workedMinutes    Int       @default(0)
  lateMinutes      Int       @default(0)
  undertimeMinutes Int       @default(0)
  otMinutes        Int       @default(0)
  nightDiffMinutes Int       @default(0)
  status           DtrStatus
  /// e.g. MISSING_TIME_OUT, CORRECTED
  remarks          String?
  computedAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([employeeId, date])
  @@index([date, status])
}

// ---------- Leave, OT, corrections, approvals ----------

model LeaveType {
  id            String         @id @default(cuid())
  /// VL, SL, SIL
  code          String         @unique
  name          String
  paid          Boolean        @default(true)
  defaultDays   Decimal        @db.Decimal(5, 1)
  /// The website's rules (Maintenance > Leave types)
  /// { kind: "yearly" } | { kind: "monthly", perMonth } | { kind: "per-event" } | { kind: "unlimited" }
  earning       Json           @default("{\"kind\":\"yearly\"}")
  carryOverMax  Decimal        @default(0) @db.Decimal(5, 1)
  /// workdays or calendar
  countBy       String         @default("workdays")
  /// everyone, female, male-married, solo-parent, after-1-year, after-6-months
  eligibility   String         @default("everyone")
  /// A document is needed when a request is longer than this many days (null = never)
  attachmentOver Decimal?      @db.Decimal(5, 1)
  confidential  Boolean        @default(false)
  basis         String         @default("")
  active        Boolean        @default(true)
  balances      LeaveBalance[]
  leaveRequests LeaveRequest[]
}

/// HR adds or takes away VL/SL days (typeId "credits") or days of one leave type, with the reason
model LeaveAdjustment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  typeId     String
  days       Decimal  @db.Decimal(5, 1)
  reason     String
  by         String
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([employeeId])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  entitled    Decimal   @db.Decimal(5, 1)
  used        Decimal   @default(0) @db.Decimal(5, 1)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType        @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime         @db.Date
  endDate     DateTime         @db.Date
  days        Decimal          @db.Decimal(5, 1)
  reason      String
  status      RequestStatus    @default(PENDING)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  approval    ApprovalRequest?

  @@index([employeeId, startDate])
}

model OtRequest {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime         @db.Date
  minutes    Int
  reason     String
  status     RequestStatus    @default(PENDING)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  approval   ApprovalRequest?
}

/// Permission to leave early. minutes = shift end minus leaveAt, computed when filed.
model UndertimeRequest {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime         @db.Date
  leaveAt    DateTime         @db.Timestamptz(3)
  minutes    Int
  reason     String
  status     RequestStatus    @default(PENDING)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  approval   ApprovalRequest?

  @@index([employeeId, date])
}

model DtrCorrection {
  id               String           @id @default(cuid())
  employeeId       String
  employee         Employee         @relation(fields: [employeeId], references: [id])
  date             DateTime         @db.Date
  requestedTimeIn  DateTime?        @db.Timestamptz(3)
  requestedTimeOut DateTime?        @db.Timestamptz(3)
  reason           String
  status           RequestStatus    @default(PENDING)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  approval         ApprovalRequest?
}

model ApprovalRequest {
  id                 String            @id @default(cuid())
  type               ApprovalType
  employeeId         String
  employee           Employee          @relation(fields: [employeeId], references: [id])
  /// Human-readable summary, e.g. "Vacation · 29–30 Sep · 2 days"
  detail             String
  status             RequestStatus     @default(PENDING)
  decidedById        String?
  decidedBy          User?             @relation(fields: [decidedById], references: [id])
  decidedAt          DateTime?         @db.Timestamptz(3)
  reason             String?
  leaveRequestId     String?           @unique
  leaveRequest       LeaveRequest?     @relation(fields: [leaveRequestId], references: [id])
  otRequestId        String?           @unique
  otRequest          OtRequest?        @relation(fields: [otRequestId], references: [id])
  dtrCorrectionId    String?           @unique
  dtrCorrection      DtrCorrection?    @relation(fields: [dtrCorrectionId], references: [id])
  undertimeRequestId String?           @unique
  undertimeRequest   UndertimeRequest? @relation(fields: [undertimeRequestId], references: [id])
  /// The approval workflow steps that applied when it was filed (Maintenance > Rules)
  steps              Json              @default("[]")
  /// Which of those steps it's waiting on (0 = the first)
  step               Int               @default(0)
  /// Who approved the earlier steps, and when
  stepLog            Json              @default("[]")
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

// ---------- Payroll ----------

/// Statutory contribution / tax tables. config is JSON; sample rows carry "verified": false.
model StatutoryRate {
  id            String   @id @default(cuid())
  /// SSS, PHILHEALTH, PAGIBIG, WITHHOLDING_TAX
  name          String
  effectiveFrom DateTime @db.Date
  config        Json

  @@unique([name, effectiveFrom])
}

model PayrollRun {
  id              String           @id @default(cuid())
  cutoffFrom      DateTime         @db.Date
  cutoffTo        DateTime         @db.Date
  payDate         DateTime         @db.Date
  status          PayrollRunStatus @default(DRAFT)
  totalGross      Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal          @default(0) @db.Decimal(14, 2)
  totalNet        Decimal          @default(0) @db.Decimal(14, 2)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  /// The website works the run out (lib/pay/engine.ts) and the backend keeps it: name, lines and adjustments as sent
  label           String           @default("")
  lines           Json             @default("[]")
  adjustments     Json             @default("{}")
  auto            Json             @default("{}")
  createdBy       String           @default("")
  computedAt      DateTime         @default(now()) @db.Timestamptz(3)
  reviewedBy      String?
  reviewedAt      DateTime?        @db.Timestamptz(3)
  approvedBy      String?
  approvedAt      DateTime?        @db.Timestamptz(3)
  payslips        Payslip[]

  @@unique([cutoffFrom, cutoffTo])
}

model Payslip {
  id                     String     @id @default(cuid())
  payrollRunId           String
  payrollRun             PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               Employee   @relation(fields: [employeeId], references: [id])
  daysPaid               Decimal    @db.Decimal(5, 1)
  basicPay               Decimal    @db.Decimal(14, 2)
  overtimePay            Decimal    @db.Decimal(14, 2)
  nightDiffPay           Decimal    @db.Decimal(14, 2)
  holidayPay             Decimal    @db.Decimal(14, 2)
  lateUndertimeDeduction Decimal    @db.Decimal(14, 2)
  grossPay               Decimal    @db.Decimal(14, 2)
  sss                    Decimal    @db.Decimal(14, 2)
  philhealth             Decimal    @db.Decimal(14, 2)
  pagibig                Decimal    @db.Decimal(14, 2)
  withholdingTax         Decimal    @db.Decimal(14, 2)
  totalDeductions        Decimal    @db.Decimal(14, 2)
  netPay                 Decimal    @db.Decimal(14, 2)

  @@unique([payrollRunId, employeeId])
}

// ---------- Payroll inputs (set on the website: Payroll > Pay details, Loans & deductions) ----------

/// Company-wide settings by key, e.g. "paydays" = { cutoffDays: [10, 25] }
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Each employee's pay settings from MSMA's workbook: work week, allowances and tax-free pay
model PayProfile {
  employeeId         String   @id
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workWeek           String   @default("5-day")
  transportAllowance Decimal  @default(0) @db.Decimal(14, 2)
  otMealRate         Decimal  @default(0) @db.Decimal(14, 2)
  deMinimis          Decimal  @default(0) @db.Decimal(14, 2)
  otherNonTaxable    Decimal  @default(0) @db.Decimal(14, 2)
  clientShare        Decimal  @default(0) @db.Decimal(5, 2)
  client             String   @default("")
  skipSss            Boolean  @default(false)
  skipPhilhealth     Boolean  @default(false)
  skipPagibig        Boolean  @default(false)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

/// SSS / Pag-IBIG loans, cash advances and other deductions taken from each cut-off until paid
model Loan {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  kind        String
  reference   String
  principal   Decimal   @db.Decimal(14, 2)
  installment Decimal   @db.Decimal(14, 2)
  startDate   DateTime  @db.Date
  /// active, stopped (no more deductions) or settled (closed in final pay)
  status      String    @default("active")
  note        String?
  createdBy   String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  closedBy    String?
  closedAt    DateTime? @db.Timestamptz(3)

  @@index([employeeId])
}

/// Holidays HR adds on the website's calendar (the national ones are built into the website)
model HolidayRule {
  id        String      @id
  name      String
  type      HolidayType
  /// { kind: "fixed", month, day } or { kind: "once", date }
  repeat    Json
  offices   String[]
  source    String
  createdBy String
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
}

/// A one-year move or cancellation of a holiday (built-in or added by HR), from a proclamation
model HolidayChange {
  id     String    @id @default(cuid())
  ruleId String
  year   Int
  kind   String
  date   DateTime? @db.Date
  source String
  by     String
  at     DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([ruleId, year])
}

// ---------- Company policies (Maintenance > Rules on the website) ----------

/// A company rule or policy HR publishes; changing a published one's content makes a new version
model Policy {
  id            String      @id
  title         String
  /// Employee handbook, Code of conduct, Attendance & time, Leave, Pay & benefits, Data privacy, Health & safety, Other
  category      String
  version       Int         @default(1)
  effectiveDate DateTime    @db.Date
  summary       String      @default("")
  body          String      @default("")
  fileId        String?
  fileName      String?
  requireAck    Boolean     @default(true)
  /// draft, published or archived
  status        String      @default("draft")
  updatedBy     String
  updatedAt     DateTime    @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  acks          PolicyAck[]
}

/// An employee confirmed they read one version of a policy
model PolicyAck {
  id         String   @id @default(cuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version    Int
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([policyId, version, employeeId])
}

// ---------- Onboarding (Recruitment, Pipeline, Trainings on the website) ----------

/// A role HR is hiring for; applicants apply to it through the shared job link
model JobRequisition {
  id             String      @id @default(cuid())
  title          String
  department     String
  cluster        String?
  office         String
  openings       Int
  /// Sourcing, Interviewing, Offer extended, Filled, On hold
  stage          String      @default("Sourcing")
  /// Pending L1, Pending L2 or Approved
  approval       String      @default("Pending L1")
  employmentType String?
  targetStart    DateTime?   @db.Date
  salaryRange    String?
  justification  String?
  createdBy      String
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  applicants     Applicant[]
}

/// Someone who applied for a requisition; the rest of what they sent (education, history, cover letter) is in profile
model Applicant {
  id            String         @id
  requisitionId String
  requisition   JobRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  email         String?
  phone         String?
  /// Applied, Screening, Interview, Offered, Hired, Rejected
  stage         String         @default("Applied")
  source        String?
  note          String?
  appliedAt     DateTime       @default(now()) @db.Timestamptz(3)
  profile       Json           @default("{}")

  @@index([requisitionId])
}

/// A training assigned to an employee
model TrainingRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  course     String
  dueDate    DateTime @db.Date
  /// Not started, In progress, Completed
  status     String   @default("Not started")
  assignedBy String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([employeeId])
}

// ---------- Support tickets and the subscription (Administration on the website) ----------

/// A problem or question a client's person sends to our support team
model SupportTicket {
  id                String           @id @default(cuid())
  number            Int              @unique
  subject           String
  category          String
  /// low, normal, high, urgent
  priority          String           @default("normal")
  /// open, in_progress, waiting, resolved, closed
  status            String           @default("open")
  filedBy           String
  filedById         String
  filedByEmployeeId String?
  /// admin (shared in the HR workspace), manager or employee (private)
  workspace         String           @default("admin")
  page              String?
  assignee          String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @db.Timestamptz(3)
  messages          SupportMessage[]
}

model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  by       String
  /// client or support
  side     String
  text     String
  at       DateTime      @default(now()) @db.Timestamptz(3)

  @@index([ticketId])
}

/// Seat alerts, refused adds, upgrade requests and plan changes (the plan itself is AppSetting "subscription")
model SubscriptionEvent {
  id      String   @id @default(cuid())
  kind    String
  message String
  by      String?
  seats   String
  admins  String
  at      DateTime @default(now()) @db.Timestamptz(3)
}

// ---------- Bell notifications ----------

/// One notice for one person: a request to decide, a decision, a change to their records, company news
model Notification {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// request, approved, rejected, update, seat or alert (the bell's icon)
  kind   String
  /// What it's about (leave, overtime, payslip, policy, support...), for its page
  topic  String
  title  String
  body   String
  /// The page where it's dealt with, for this person's role
  link   String?
  at     DateTime  @default(now()) @db.Timestamptz(3)
  readAt DateTime? @db.Timestamptz(3)

  @@index([userId, at])
}

// ---------- Reimbursements (Requests > Reimbursements on the website) ----------

/// An expense claim: the approver endorses it, Accounting gives the final approval and releases the money
/// (cash, bank transfer, e-wallet or check). Never paid through payroll.
model Claim {
  id                String    @id @default(cuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  category          String
  otherType         String?
  merchant          String
  purchaseDate      DateTime  @db.Date
  amount            Decimal   @db.Decimal(14, 2)
  description       String
  /// The receipt photo (a compressed JPEG data URL)
  receipt           String
  /// pending (with the approver), endorsed (with Accounting), approved, rejected
  status            String    @default("pending")
  filedAt           DateTime  @default(now()) @db.Timestamptz(3)
  approverDecidedBy String?
  approverDecidedAt DateTime? @db.Timestamptz(3)
  approverNote      String?
  decidedBy         String?
  decidedAt         DateTime? @db.Timestamptz(3)
  note              String?
  paidAt            DateTime? @db.Timestamptz(3)
  paidBy            String?
  /// cash, transfer, e-wallet or check
  payoutMethod      String?
  payoutRef         String?

  @@index([employeeId, filedAt])
  @@index([status])
}

/// A certificate an employee asked for (COE, BIR 2316, employment verification). HR issues a digital copy, or
/// prepares a signed copy for pickup, or declines it. Issuing files the exact copy (number, wording) on the request.
model CertificateRequest {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  type        String
  purpose     String    @default("")
  /// Pending, Ready for pickup, Released or Declined
  status      String    @default("Pending")
  requestedOn DateTime  @default(now()) @db.Timestamptz(3)
  handledBy   String?
  handledAt   DateTime? @db.Timestamptz(3)
  /// digital or pickup
  delivery    String?
  note        String?
  /// The copy filed when issued: { number, statement, purpose, issuedAt, issuedBy }
  issued      Json?

  @@index([employeeId])
}

// ---------- Audit ----------

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id])
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([at])
}
