{
  "name": "@msma/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed MSMA HRIS API client generated from the API's OpenAPI spec (openapi-typescript + openapi-fetch)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
