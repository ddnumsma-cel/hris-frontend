# Leave EXPO_PUBLIC_API_URL empty (recommended). The app then reaches the API through the Expo dev server
# (<address it loaded from>/__api), which works on any Wi-Fi and with `pnpm mobile:tunnel`.
#
# Only set it to use a different API, e.g. a deployed test server, then restart `pnpm mobile`:
#   EXPO_PUBLIC_API_URL=https://hris-test.example.com
EXPO_PUBLIC_API_URL=
