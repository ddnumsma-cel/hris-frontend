{
  "name": "@msma/api",
  "version": "0.1.0",
  "private": true,
  "description": "MSMA HRIS REST API (NestJS 11). Swagger at http://localhost:4000/docs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "recompute": "node dist/cli/recompute.js",
    "openapi": "nest build && node dist/cli/openapi.js",
    "simulate:punch": "tsx scripts/simulate-punch.ts"
  },
  "dependencies": {
    "@msma/db": "workspace:*",
    "@msma/shared": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
