# Copy to .env (Windows cmd: copy .env.example .env) or run `pnpm bootstrap`.
# Local development values only. Never commit .env.

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://msma:msma_local_dev@localhost:5432/msma_hris?schema=public"
TEST_DATABASE_URL="postgresql://msma:msma_local_dev@localhost:5432/msma_hris_test?schema=public"

# API
API_PORT=4000
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Web (Next.js) -> API
# The browser reaches the API through the web server at /api, so it works on this PC, from other PCs
# and with `pnpm share`. Leave empty; set a full URL only for an API hosted somewhere else.
NEXT_PUBLIC_API_URL=""
# Where the web server finds the API (default http://127.0.0.1:API_PORT)
# API_INTERNAL_URL="http://127.0.0.1:4000"

# Temporary phone clock-in (fingerprint / face / PIN on the phone). Set to false once the
# attendance machines are in use.
# PHONE_CLOCK_ENABLED="true"

# 201 file documents (default: <project>/storage/documents, never committed)
# DOCUMENT_STORAGE_DIR="D:/msma-hris-data/documents"

# Our support and platform team (answer support tickets, change the plan and seats), comma separated emails.
PLATFORM_ADMIN_EMAILS=
